# Discord bot token (dev portal -> Bot -> Token)
DISCORD_TOKEN=

# Devin v3 API credentials (Settings -> Service Users / Devin API)
# The service user needs: UseDevinSessions, ManageOrgSessions, ViewOrgSessions.
# Admin role is the easy path and also grants ImpersonateOrgSessions for
# CREATE_AS_USER_ID / message attribution.
DEVIN_API_KEY=cog_...
DEVIN_ORG_ID=org-...
# DEVIN_BASE_URL=https://api.devin.ai/v3

# Comma-separated Discord user IDs allowed to use the bot. REQUIRED -- an
# allowlisted user can spend ACUs, so an empty list refuses everything.
ALLOWED_USER_IDS=

# Private guild text channel where session threads are created. Required
# for /devin (bots cannot create threads in DMs).
HUB_CHANNEL_ID=

# Attribute sessions/messages to your real Devin user so they appear in
# your web-app session list (needs ImpersonateOrgSessions on the key).
# CREATE_AS_USER_ID=

# Per-session defaults. lite is the cheap mode -- good for phone tasks.
DEVIN_MODE=lite
MAX_ACU_LIMIT=25

# Set to your guild ID for instant slash-command sync while developing
# (global sync also runs, so commands reach DMs once they propagate).
# COMMAND_GUILD_ID=

POLL_INTERVAL_SECONDS=15
DB_PATH=devinmobile.db

# --- Model selection (/devin model:) -------------------------------------
# v3 has no model field, so model-selected sessions are created over the
# internal ACP bridge (wss://<api>/acp/live) that the Devin CLI/Desktop use.
# Auth comes from the CLI's own credential file -- run `devin auth login`
# once on this host (browser flow; --force-manual-token-flow for headless).
# Sessions are created AS the logged-in user, so no CREATE_AS_USER_ID needed.
# Caveats of the bridge path: no tags / structured_output_schema /
# max_acu_limit — those exist only on the v3 create path.
# DEVIN_CREDENTIALS_PATH=~/.local/share/devin/credentials.toml
# DEVIN_API_URL_OVERRIDE=   # staging/enterprise API host, if applicable
# BRIDGE_TIMEOUT=60
