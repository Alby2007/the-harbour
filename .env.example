# Discord bot token (dev portal -> Bot -> Token)
DISCORD_TOKEN=

# Devin v3 API credentials (Settings -> Service Users / Devin API)
# The service user needs: UseDevinSessions, ManageOrgSessions, ViewOrgSessions.
# Admin role is the easy path and also grants ImpersonateOrgSessions for
# CREATE_AS_USER_ID / message attribution.
DEVIN_API_KEY=cog_...
DEVIN_ORG_ID=org-...
# DEVIN_BASE_URL=https://api.devin.ai/v3

# Comma-separated Discord user IDs allowed to use the bot. REQUIRED -- an
# allowlisted user can spend ACUs, so an empty list refuses everything.
ALLOWED_USER_IDS=

# Private guild text channel where session threads are created. Required
# for /devin (bots cannot create threads in DMs).
HUB_CHANNEL_ID=

# Attribute sessions/messages to your real Devin user so they appear in
# your web-app session list (needs ImpersonateOrgSessions on the key).
# CREATE_AS_USER_ID=

# Per-session defaults. lite is the cheap mode -- good for phone tasks.
DEVIN_MODE=lite
MAX_ACU_LIMIT=25

# Set to your guild ID for instant slash-command sync while developing
# (global sync also runs, so commands reach DMs once they propagate).
# COMMAND_GUILD_ID=

POLL_INTERVAL_SECONDS=5
DB_PATH=devinmobile.db
# A "running" session that goes this many minutes without a relayed message
# posts one quiet "still working?" note (0 disables).
# SILENCE_ALERT_MINUTES=20
# Voice-note steering: an audio attachment in a bound thread is transcribed
# via OpenAI Whisper and sent to the session as text. Off when unset.
# OPENAI_API_KEY=

# --- Model selection (/devin model:) -------------------------------------
# v3 has no model field, so model-selected sessions are created over the
# internal ACP bridge (wss://<api>/acp/live) that the Devin CLI/Desktop use.
# Auth comes from the CLI's own credential file -- run `devin auth login`
# once on this host (browser flow; --force-manual-token-flow for headless).
# Sessions are created AS the logged-in user, so no CREATE_AS_USER_ID needed.
# Caveats of the bridge path: no tags / structured_output_schema /
# max_acu_limit — those exist only on the v3 create path.
# DEVIN_CREDENTIALS_PATH=~/.local/share/devin/credentials.toml
# DEVIN_API_URL_OVERRIDE=   # staging/enterprise API host, if applicable
# BRIDGE_TIMEOUT=60
#
# Route every /devin through the bridge by default (explicit model: or mode:
# args override). e.g. DEVIN_DEFAULT_MODEL=swe2-max
# DEVIN_DEFAULT_MODEL=
#
# The same bridge powers live progress: a persistent socket session/load's
# each active session and relays tool_call titles into the thread as a
# throttled "Working…" message. Set to 0 to disable.
# ACP_PROGRESS=1

# --- GitHub App (PR cards/actions, CI status, issue:, webhooks) -----------
# Powers: PR cards in threads with Merge/Approve/Close buttons, CI status
# in PR embeds + transition pings, `/devin issue:` context intake, and the
# optional webhook receiver. Without it the bot still works — PRs just
# render as links like before.
#
# Create at github.com/settings/apps (or org settings): permissions
#   Pull requests: write · Contents: write · Issues: read · Checks: read
#   (Checks is metadata-read; Contents:write is required for merge.)
# Subscribe to webhook events: pull_request, pull_request_review,
# pull_request_review_comment, check_run, check_suite, issues.
# Install it on the account/org holding your repos and note the
# installation id (github.com/settings/installations -> the app's page URL).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem   # PEM file, not inline
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_MERGE_METHOD=squash                     # merge | squash | rebase
#
# Webhook receiver (optional — the relay already polls every
# POLL_INTERVAL_SECONDS, this just makes transitions instant, plus enables
# two webhook-only features: review comments relayed into the thread, and
# auto-spawning a session when an issue gets the trigger label). Point a
# tunnel (cloudflared/ngrok) or public URL at /github on this port and set
# the same secret in the app's webhook config.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_PORT=8977
# GITHUB_TRIGGER_LABEL=devin   # issue label that spawns a session
